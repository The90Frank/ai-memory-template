#!/bin/sh
# Blocks direct commits on main.
#
# main is the common base shared between machines and takes no work commits:
# every machine commits on its own branch. See ltm/feedback/machine-branches.md
#
# Deliberate override:  git commit --no-verify

branch=$(git symbolic-ref --short -q HEAD)

if [ "$branch" = "main" ]; then
	printf '\n  commit refused: main takes no commits.\n\n' >&2
	printf '  Every machine commits on its own branch.\n' >&2
	printf '  Available branches:\n' >&2
	git for-each-ref --format='    %(refname:short)' refs/heads/ >&2
	printf '\n  Deliberate override: git commit --no-verify\n\n' >&2
	exit 1
fi

exit 0
